# --- App ---
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Postgres (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trust_rag
POSTGRES_PASSWORD=trust_rag_dev
POSTGRES_DB=trust_rag

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (via LiteLLM) ---
OPENAI_API_KEY=sk-...
GENERATION_MODEL=gpt-4o-mini
VERIFICATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse tracing (optional; disabled by default) ---
# Self-host stack: see docs/langfuse.md — attach the official compose file.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
