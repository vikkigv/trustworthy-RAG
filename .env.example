# --- App ---
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Postgres (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trust_rag
POSTGRES_PASSWORD=trust_rag_dev
POSTGRES_DB=trust_rag

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM ---
# Chat/generation via Z.ai (OpenAI-compatible) through LiteLLM
Z_AI_API_KEY=your-zai-key
Z_AI_API_BASE=https://api.z.ai/api/paas/v4
GENERATION_MODEL=glm-4.6
VERIFICATION_MODEL=glm-4.6
# Embeddings run locally (BGE-M3, no API needed); cached under HF_HOME
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# --- Langfuse tracing (optional; disabled by default) ---
# Self-host stack: see docs/langfuse.md — attach the official compose file.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
