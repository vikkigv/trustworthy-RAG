# --- App ---
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Postgres (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trust_rag
POSTGRES_PASSWORD=trust_rag_dev
POSTGRES_DB=trust_rag

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (defaults: local Ollama, no key needed) ---
# Requires: ollama pull bge-m3 && ollama pull qwen2.5:7b
LLM_API_BASE=http://localhost:11434/v1
EMBEDDING_API_BASE=http://localhost:11434/v1
GENERATION_MODEL=qwen2.5:7b
VERIFICATION_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# To use Z.ai for chat instead: set LLM_API_BASE=https://api.z.ai/api/paas/v4,
# LLM_API_KEY=<zai-key>, GENERATION_MODEL=glm-4.6
Z_AI_API_KEY=
Z_AI_API_BASE=https://api.z.ai/api/paas/v4

# --- Langfuse tracing (optional; disabled by default) ---
# Self-host stack: see docs/langfuse.md — attach the official compose file.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
