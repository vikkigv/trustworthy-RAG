# --- App ---
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Postgres (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trust_rag
POSTGRES_PASSWORD=trust_rag_dev
POSTGRES_DB=trust_rag

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (via LiteLLM; Z.ai/Zhipu by default) ---
Z_AI_API_KEY=your-zai-key
GENERATION_MODEL=zai/glm-4.6
VERIFICATION_MODEL=zai/glm-4.6
EMBEDDING_MODEL=zai/embedding-3

# --- Langfuse tracing (optional; disabled by default) ---
# Self-host stack: see docs/langfuse.md — attach the official compose file.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
